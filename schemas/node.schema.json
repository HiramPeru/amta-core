{
  "$defs": {
    "NodeStatus": {
      "description": "Supported AMTA node states for v0.1.",
      "enum": [
        "proposed",
        "active",
        "blocked",
        "completed",
        "deprecated"
      ],
      "title": "NodeStatus",
      "type": "string"
    },
    "NodeType": {
      "description": "Supported AMTA node types for v0.1.",
      "enum": [
        "decision",
        "task",
        "constraint",
        "incident",
        "module",
        "event"
      ],
      "title": "NodeType",
      "type": "string"
    },
    "RelationModel": {
      "additionalProperties": false,
      "description": "Directed relation declared by a node.",
      "properties": {
        "target": {
          "pattern": "^[A-Z]{3}-[0-9]{3,}$",
          "title": "Target",
          "type": "string"
        },
        "type": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "target"
      ],
      "title": "RelationModel",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Local AMTA node model.",
  "properties": {
    "body": {
      "default": "",
      "title": "Body",
      "type": "string"
    },
    "created": {
      "format": "date",
      "title": "Created",
      "type": "string"
    },
    "id": {
      "pattern": "^[A-Z]{3}-[0-9]{3,}$",
      "title": "Id",
      "type": "string"
    },
    "owner": {
      "maxLength": 100,
      "minLength": 1,
      "title": "Owner",
      "type": "string"
    },
    "relations": {
      "items": {
        "$ref": "#/$defs/RelationModel"
      },
      "title": "Relations",
      "type": "array"
    },
    "revision": {
      "minimum": 1,
      "title": "Revision",
      "type": "integer"
    },
    "status": {
      "$ref": "#/$defs/NodeStatus"
    },
    "summary": {
      "maxLength": 500,
      "minLength": 1,
      "title": "Summary",
      "type": "string"
    },
    "tags": {
      "items": {
        "type": "string"
      },
      "title": "Tags",
      "type": "array"
    },
    "title": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "type": {
      "$ref": "#/$defs/NodeType"
    },
    "updated": {
      "format": "date",
      "title": "Updated",
      "type": "string"
    }
  },
  "required": [
    "id",
    "type",
    "status",
    "title",
    "summary",
    "owner",
    "revision",
    "created",
    "updated"
  ],
  "title": "NodeModel",
  "type": "object"
}
